# ==============================================================================
# SportsAgenticAgent Configuration
# ==============================================================================
# Copy this file to .env before starting:
#   cp .env.example .env

# 1. SportsAgentic MCP Server Settings
MCP_SERVER_URL=http://localhost:8080/sse
MCP_TIMEOUT_SECONDS=10.0

# 2. llama-server (Primary Local Inference)
LLAMA_SERVER_URL=http://localhost:8081/v1
LLAMA_MODEL=local-model
LLAMA_TIMEOUT_SECONDS=15.0

# 3. Google Gemini (Backup / Alternative Inference)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# 4. Agent & Runtime Settings
# Options: "auto" (llama-server primary with Gemini fallback), "llama", "gemini"
DEFAULT_LLM_PROVIDER=auto
MAX_TOOL_ITERATIONS=5
SKILLS_DIR=skills
LOG_LEVEL=INFO
PORT=8000
